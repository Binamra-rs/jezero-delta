# Hosted build (Netlify / Vercel / Cloudflare Pages). Override in the host's
# environment settings rather than editing this file.
# Static map data exported by backend/scripts/export_static.py into public/map
VITE_STATIC_BASE=/map
# URL of the deployed API (e.g. https://jezero-api.onrender.com). Leave empty to
# deploy the map only (inspect / routing / raw images then show a notice).
VITE_API_BASE=
