# Copy to backend/.env for local runs without Docker. Real env vars override these.
JEZERO_ENV=development
# Waypoint database (SQLite file). Default: <data dir>/jezero.sqlite3
# JEZERO_DB_PATH=C:/jezero-data/jezero.sqlite3
# Leave unset to use <repo>/data ; or point at another folder holding processed/
# JEZERO_DATA_DIR=C:/jezero-data
JEZERO_CORS_ORIGINS=http://localhost:5173
JEZERO_NASA_RAW_API_URL=https://mars.nasa.gov/rss/api/
JEZERO_NASA_CACHE_SECONDS=600
JEZERO_LOG_LEVEL=INFO
