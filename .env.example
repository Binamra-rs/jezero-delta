# ---------------------------------------------------------------------------
# Jezero Delta Explorer — production environment template.
# Copy to deploy/.env on the VPS, fill in, `chmod 600 deploy/.env`. Never commit it.
# ---------------------------------------------------------------------------
JEZERO_ENV=production

# Waypoints are stored in one SQLite file. In docker compose it lives on the
# `state` volume (JEZERO_DB_PATH is set there); no database server is needed.

# Auth: generate with `python3 -c "import secrets;print(secrets.token_urlsafe(48))"`
JEZERO_JWT_SECRET=
JEZERO_JWT_TTL_HOURS=72
JEZERO_ALLOW_REGISTRATION=true

# Exact production origins of the frontend (comma separated, no localhost)
JEZERO_CORS_ORIGINS=https://astro-mars.wiki,https://www.astro-mars.wiki

# Host directory holding raw/ processed/ reports/ (mounted read-only into the API)
JEZERO_HOST_DATA_DIR=/srv/jezero/data
JEZERO_TILE_CACHE_SECONDS=86400
JEZERO_ROUTE_RATE_PER_MINUTE=20
JEZERO_AUTH_RATE_PER_MINUTE=10
JEZERO_LOG_LEVEL=INFO

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel)
TUNNEL_TOKEN=

# Optional error monitoring
SENTRY_DSN=

# Backups (deploy/backup/backup.sh)
BACKUP_DIR=/srv/jezero/backups
BACKUP_RETENTION_DAYS=30
# Optional off-site copy to Cloudflare R2 via rclone remote name (e.g. "r2:jezero-backups")
BACKUP_RCLONE_REMOTE=
