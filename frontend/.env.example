# Base URL of the deployed API (no trailing slash). Never localhost in production builds.
VITE_API_BASE=https://jezero-api.onrender.com
# Serve config + tiles as static files exported by backend/scripts/export_static.py
# (leave unset to load everything from the API, e.g. during local development)
VITE_STATIC_BASE=/map
# Where waypoints live: 'local' (this browser) or 'api' (server SQLite).
# Default: local when VITE_STATIC_BASE is set, otherwise api.
# VITE_WAYPOINTS=local
